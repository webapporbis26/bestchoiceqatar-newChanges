@{
    ViewBag.Title = "Portable Office Cabins Qatar | Premium Site Office Solutions";
    ViewBag.description = "BestChoice Qatar provides high-quality portable office cabins for construction sites and corporate use. Custom-built, climate-controlled, and durable office units in Doha.";
    ViewBag.keywords = "portable office cabins qatar, site office doha, porta cabin office, modular office qatar";
}

<main id="main" class="product-detail-page">

    <!-- Hero Section -->
    <section class="page-hero" style="background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/Uploads/Products/cabin-1.jpg') center/cover no-repeat; padding: 120px 0 80px;">
        <div class="container text-center" data-aos="fade-up">
            <h1 class="display-4 fw-bold text-white mb-3">Portable Office Cabins</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center">
                    <li class="breadcrumb-item"><a href="/index" class="text-warning">Home</a></li>
                    <li class="breadcrumb-item"><a href="/portable-cabin-fabrication" class="text-warning">Fabrication</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">Office Cabins</li>
                </ol>
            </nav>
        </div>
    </section>

    <!-- Content Section -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6" data-aos="fade-right">
                    <span class="section-label">Executive Workspace</span>
                    <h2 class="section-title">Premium Portable Office Solutions</h2>
                    <p class="lead text-muted mt-4">We design and manufacture high-end portable office cabins that provide a professional workspace environment on any project site in Qatar.</p>
                    <p class="text-muted">Our office units are built with reinforced steel frames and superior insulation, ensuring a quiet and productive atmosphere even in busy industrial zones.</p>
                    
                    <div class="row mt-4">
                        <div class="col-md-6 mb-3">
                            <ul class="list-unstyled">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Custom Interior Layouts</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> T3 Tropical Rated AC</li>
                            </ul>
                        </div>
                        <div class="col-md-6 mb-3">
                            <ul class="list-unstyled">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Premium Flooring</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Rapid Site Setup</li>
                            </ul>
                        </div>
                    </div>

                    <a href="/contact" class="btn-bc btn-bc-yellow mt-4">Request a Quote <i class="bi bi-arrow-right ms-2"></i></a>
                </div>
                <div class="col-lg-6" data-aos="fade-left">
                    <div class="position-relative">
                        <img src="/Uploads/WhatsApp Image 2026-04-22 at 3.41.42 PM.jpeg" class="img-fluid shadow-lg" alt="Portable Office Cabin" style="border-radius: 20px;">
                        <div class="bg-primary-yellow position-absolute p-4 d-none d-md-block" style="bottom: -30px; right: -30px; border-radius: 15px; max-width: 250px;">
                            <h5 class="fw-bold mb-0 text-dark">Ready for Immediate Use</h5>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Technical Specifications -->
            <div class="row mt-5 pt-5" data-aos="fade-up">
                <div class="col-12">
                    <h3 class="fw-bold mb-4">Technical Specifications</h3>
                    <div class="table-responsive">
                        <table class="table table-bordered custom-table">
                            <thead class="bg-dark text-white">
                                <tr>
                                    <th>Feature</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Chassis</strong></td>
                                    <td>ISMC Reinforced Structural Steel</td>
                                </tr>
                                <tr>
                                    <td><strong>Wall Panels</strong></td>
                                    <td>50mm/100mm EPS or Rockwool Sandwich Panels</td>
                                </tr>
                                <tr>
                                    <td><strong>Insulation</strong></td>
                                    <td>High-density Fire Resistant Materials</td>
                                </tr>
                                <tr>
                                    <td><strong>Flooring</strong></td>
                                    <td>18mm Cement Board with Premium Vinyl Finish</td>
                                </tr>
                                <tr>
                                    <td><strong>Electrical</strong></td>
                                    <td>Concealed wiring with DB Box & LED Lighting</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Sizes & Pricing Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-6" data-aos="fade-right">
                    <span class="section-label">Sizes &amp; Pricing</span>
                    <h2 class="section-title mb-4">Standard Sizes, Built to Order</h2>
                    <p class="text-muted">Office cabins are manufactured in our Qatar facility to standard footprints, with custom dimensions and interior layouts available on request.</p>
                    <div class="table-responsive">
                        <table class="table table-bordered bg-white mb-0">
                            <tbody>
                                <tr><th scope="row" style="width:38%;">Standard — 3M x 6M</th><td>From QAR 8,000</td></tr>
                                <tr><th scope="row">Large — 3.75M x 7M</th><td>From QAR 14,000</td></tr>
                                <tr><th scope="row">Custom sizes</th><td>Built to order — share your drawings for a quote</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p class="small text-muted mt-3">Prices are indicative only. See the full <a href="/portable-cabin-price-in-qatar">portable cabin price guide</a>.</p>
                </div>
                <div class="col-lg-6" data-aos="fade-left">
                    <span class="section-label">Industries Served</span>
                    <h2 class="section-title mb-4">Where Office Cabins Work</h2>
                    <ul class="list-unstyled mt-4">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Construction &amp; Infrastructure</strong> — site headquarters and project offices</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Oil, Gas &amp; Energy</strong> — offices for Ras Laffan and Mesaieed sites</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Commercial &amp; Retail</strong> — temporary and pop-up offices</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Education &amp; Healthcare</strong> — classrooms, clinics and admin blocks</li>
                    </ul>
                    <p class="text-muted">Every cabin is delivered turnkey — flat-pack or fully assembled — with on-site installation anywhere in Qatar. Learn how they are built on our <a href="/portable-cabin-fabrication">fabrication page</a>.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto" data-aos="fade-up">
                    <span class="section-label">FAQ</span>
                    <h2 class="section-title mb-4">Office Cabin Questions, Answered</h2>
                    <details class="faq-item">
                        <summary>What sizes do portable office cabins come in?</summary>
                        <div class="faq-answer">Our standard office cabins are 3M x 6M, with an indicative starting price of QAR 8,000, and 3.75M x 7M large units from QAR 14,000. Every cabin is built to order, so custom dimensions and interior layouts are available.</div>
                    </details>
                    <details class="faq-item">
                        <summary>Are office cabins air-conditioned for Qatar summers?</summary>
                        <div class="faq-answer">Yes. Every office cabin is fitted with T3 tropical-rated AC provisions designed for 50°C+ heat, along with EPS or Rockwool sandwich-panel insulation.</div>
                    </details>
                    <details class="faq-item">
                        <summary>How long does delivery and installation take?</summary>
                        <div class="faq-answer">Cabins are delivered turnkey, fully assembled or flat-pack, with on-site installation by our own crew. Most standard cabins are delivered and installed within a few weeks of order confirmation.</div>
                    </details>
                    <details class="faq-item">
                        <summary>Can the interior layout be customised?</summary>
                        <div class="faq-answer">Yes. Interiors can be open-plan or partitioned, with gypsum or PVC panel finishes, luxury vinyl flooring, LED lighting and dedicated power points to match your corporate standards.</div>
                    </details>
                    <details class="faq-item">
                        <summary>Where are BestChoice office cabins used?</summary>
                        <div class="faq-answer">On construction and infrastructure sites, oil and gas projects, and commercial sites across Doha, Lusail, Ras Laffan, Mesaieed, Al Khor, Dukhan, Al Wakrah, Al Rayyan and Umm Salal.</div>
                    </details>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-5" style="background:#111; color:#fff;">
        <div class="container text-center" data-aos="fade-up">
            <h2 class="fw-bold text-uppercase mb-3" style="font-size:2rem;">Need an Office Cabin for Your Site?</h2>
            <p class="mb-4" style="color:#aaa;">Manufacturing portable cabins in Qatar since 2009. Call us or request a quote for office cabins in any size.</p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a href="tel:+97450307568" class="btn-bc btn-bc-yellow"><i class="bi bi-telephone-fill me-2"></i> +974 50307568</a>
                <a href="/contact" class="btn-bc btn-bc-yellow">Request a Quote</a>
            </div>
        </div>
    </section>

    <!-- Product + FAQ JSON-LD -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Product",
      "name": "Portable Office Cabins | BestChoice Contracting Qatar",
      "description": "BestChoice Qatar provides high-quality portable office cabins for construction sites and corporate use. Custom-built, climate-controlled, and durable office units in Doha.",
      "brand": { "@@type": "Brand", "name": "BestChoice Contracting Qatar" },
      "category": "Portable Cabins",
      "offers": { "@@type": "Offer", "priceCurrency": "QAR", "price": "8000", "availability": "https://schema.org/PreOrder", "itemCondition": "https://schema.org/NewCondition" }
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "FAQPage",
      "mainEntity": [
        { "@@type": "Question", "name": "What sizes do portable office cabins come in?", "acceptedAnswer": { "@@type": "Answer", "text": "Our standard office cabins are 3M x 6M, with an indicative starting price of QAR 8,000, and 3.75M x 7M large units from QAR 14,000. Every cabin is built to order, so custom dimensions and interior layouts are available." } },
        { "@@type": "Question", "name": "Are office cabins air-conditioned for Qatar summers?", "acceptedAnswer": { "@@type": "Answer", "text": "Yes. Every office cabin is fitted with T3 tropical-rated AC provisions designed for 50°C+ heat, along with EPS or Rockwool sandwich-panel insulation." } },
        { "@@type": "Question", "name": "How long does delivery and installation take?", "acceptedAnswer": { "@@type": "Answer", "text": "Cabins are delivered turnkey, fully assembled or flat-pack, with on-site installation by our own crew. Most standard cabins are delivered and installed within a few weeks of order confirmation." } },
        { "@@type": "Question", "name": "Can the interior layout be customised?", "acceptedAnswer": { "@@type": "Answer", "text": "Yes. Interiors can be open-plan or partitioned, with gypsum or PVC panel finishes, luxury vinyl flooring, LED lighting and dedicated power points to match your corporate standards." } },
        { "@@type": "Question", "name": "Where are BestChoice office cabins used?", "acceptedAnswer": { "@@type": "Answer", "text": "On construction and infrastructure sites, oil and gas projects, and commercial sites across Doha, Lusail, Ras Laffan, Mesaieed, Al Khor, Dukhan, Al Wakrah, Al Rayyan and Umm Salal." } }
      ]
    }
    </script>

</main>

<style>
    .section-label { font-size: 0.8rem; font-weight: 700; color: #ffcc00; text-transform: uppercase; letter-spacing: 2px; display: block; margin-bottom: 10px; }
    .section-title { font-size: 2.5rem; font-weight: 800; color: #111; line-height: 1.2; }
    .btn-bc { display: inline-flex; align-items: center; padding: 15px 35px; font-weight: 700; border-radius: 5px; transition: all 0.3s; text-decoration: none; text-transform: uppercase; font-size: 0.9rem; }
    .btn-bc-yellow { background: #ffcc00; color: #111; }
    .btn-bc-yellow:hover { background: #111; color: #ffcc00; }
    .custom-table { border-radius: 10px; overflow: hidden; }
    .faq-item { border: 1px solid #eee; margin-bottom: 12px; background: #fff; }
    .faq-item summary { padding: 20px 24px; font-weight: 700; cursor: pointer; list-style: none; font-size: 1.05rem; }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary:after { content: "+"; float: right; color: #ffcc00; font-size: 1.4rem; line-height: 1; }
    .faq-item[open ] summary:after { content: "\2013"; }
    .faq-item .faq-answer { padding: 0 24px 20px; color: #555; line-height: 1.8; }
</style>
