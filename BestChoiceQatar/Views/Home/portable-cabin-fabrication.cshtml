@{
    var slug = Request.QueryString["slug"];
    if (!string.IsNullOrEmpty(slug))
    {
        @Html.Partial("ProductDetails")
        return;
    }
}

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Portable Cabin Fabrication in Qatar | BestChoice Contracting";
    ViewBag.description = "BestChoice Contracting fabricates portable cabins in Qatar - site offices, labour accommodation, security cabins, toilets and container offices. In-house manufacturing in Doha since 2009. Request a quote today.";
    ViewBag.keywords = "portable cabin fabrication qatar, porta cabin fabrication doha, modular cabins qatar, site office cabin qatar, labour camp accommodation qatar, container office qatar";

    int i = 1;
    BestChoiceQatar.Models.BestChoiceQatarEntities db = new BestChoiceQatar.Models.BestChoiceQatarEntities();
    var _product = (from b in db.Galleries
                    where b.IsDataActive && b.Category == "Portable Cabin Fabrication"
                    select new
                    {
                        b.ID,
                        b.Title,
                        b.Description,
                        b.Image,
                        b.ChildImages
                    }).FirstOrDefault();
    var settings = db.Settings.FirstOrDefault();
}


