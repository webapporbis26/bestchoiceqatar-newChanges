@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Custom Portable Cabins in Qatar | Bespoke Layouts, Sizes & Finishes | BestChoice Contracting";
    ViewBag.description = "Custom portable cabins in Qatar — fully customizable layouts, finishes and dimensions, with extra insulation, AC, partitions, plumbing and electrical work. Portable houses and custom sizes built to order since 2009.";
    ViewBag.keywords = "custom portable cabins qatar, bespoke porta cabin doha, custom cabin sizes qatar, portable houses qatar";
}

<main id="main" class="product-detail-page">

    <!-- Hero Section -->
    <section class="page-hero" style="background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/Uploads/Products/cabin-1.jpg') center/cover no-repeat; padding: 120px 0 80px;">
        <div class="container text-center" data-aos="fade-up">
            <span class="section-label">Bespoke Design</span>
            <h1 class="display-4 fw-bold text-white mb-3">Custom Portable Cabins in Qatar</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center">
                    <li class="breadcrumb-item"><a href="/index" class="text-warning">Home</a></li>
                    <li class="breadcrumb-item"><a href="/portable-cabin-fabrication" class="text-warning">Fabrication</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">Custom Cabins</li>
                </ol>
            </nav>
        </div>
    </section>

    <!-- Intro Section -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6" data-aos="fade-right">
                    <span class="section-label">Built To Your Drawing</span>
                    <h2 class="section-title">Every Cabin Built to Order</h2>
                    <p class="lead text-muted mt-4">We offer fully customizable layouts, finishes, features, and dimensions. Whether you need extra insulation, air conditioning, partitions, plumbing, or electrical work, our team can tailor your structure to meet your needs.</p>
                    <p class="text-muted">From portable houses to multi-room site complexes, every cabin is fabricated in-house at our Doha workshop by a team of 150+ specialists. We have been manufacturing portable cabins in Qatar since 2009, so a custom build is based on real build experience, not a guess.</p>
                    <div class="row mt-4">
                        <div class="col-md-6 mb-3">
                            <ul class="list-unstyled">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Custom Layouts &amp; Dimensions</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Extra Insulation &amp; AC</li>
                            </ul>
                        </div>
                        <div class="col-md-6 mb-3">
                            <ul class="list-unstyled">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Partitions, Plumbing &amp; Electrical</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Custom Finishes &amp; Branding</li>
                            </ul>
                        </div>
                    </div>
                    <a href="/contact" class="btn-bc btn-bc-yellow mt-4">Discuss Your Custom Build <i class="bi bi-arrow-right ms-2"></i></a>
                </div>
                <div class="col-lg-6" data-aos="fade-left">
                    <div class="position-relative text-center">
                        <img src="/Uploads/WhatsApp Image 2026-04-22 at 3.41.43 PM (1).jpeg" class="img-fluid shadow-lg" alt="Custom portable cabin in Qatar" style="border-radius: 20px;">
                        <div class="bg-primary-yellow position-absolute p-4 d-none d-md-block" style="bottom: -30px; right: -30px; border-radius: 15px; max-width: 250px;">
                            <h5 class="fw-bold mb-0 text-dark">Your Layout, Your Finish</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Customization Options -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="text-center mb-5" data-aos="fade-up">
                <span class="section-label">Tailor Everything</span>
                <h2 class="section-title">What You Can Customize</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4" data-aos="fade-up">
                    <div class="bc-card h-100">
                        <h4 class="fw-bold text-uppercase mb-2">Layouts &amp; Dimensions</h4>
                        <p class="text-muted mb-0">Custom sizes and floor plans — open-plan or partitioned, single rooms or multi-room complexes, single or double-storey (G+1 / G+2).</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="bc-card h-100">
                        <h4 class="fw-bold text-uppercase mb-2">Insulation &amp; Climate</h4>
                        <p class="text-muted mb-0">Extra insulation with EPS / Rockwool sandwich panels and T3 tropical-rated AC provisions for 50&deg;C+ heat.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="bc-card h-100">
                        <h4 class="fw-bold text-uppercase mb-2">Partitions &amp; Rooms</h4>
                        <p class="text-muted mb-0">Internal partitions for offices, bedrooms, kitchens, washrooms and meeting space — cellular or open-plan.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4" data-aos="fade-up">
                    <div class="bc-card h-100">
                        <h4 class="fw-bold text-uppercase mb-2">Plumbing &amp; Sanitary</h4>
                        <p class="text-muted mb-0">Plumbing for toilets, showers, washbasins and kitchens, with C-PVC / PPR hot &amp; cold water systems.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="bc-card h-100">
                        <h4 class="fw-bold text-uppercase mb-2">Electrical &amp; Data</h4>
                        <p class="text-muted mb-0">Pre-installed electrical systems with distribution boards, LED lighting, power points and concealed data &amp; communication wiring.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="bc-card h-100">
                        <h4 class="fw-bold text-uppercase mb-2">Finishes &amp; Branding</h4>
                        <p class="text-muted mb-0">Finishes from gypsum or PVC panels and vinyl flooring to premium epoxy, plus branding and special layouts.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Sizes -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-6" data-aos="fade-right">
                    <span class="section-label">Starting Points</span>
                    <h2 class="section-title mb-4">Standard Sizes — Or Yours</h2>
                    <div class="table-responsive">
                        <table class="table table-bordered bg-white mb-0">
                            <thead class="table-dark">
                                <tr><th scope="col">Cabin Type</th><th scope="col">Size</th><th scope="col">Typical Use</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Office Cabin — Standard</td><td>3m &times; 6m</td><td>Site &amp; project offices</td></tr>
                                <tr><td>Office Cabin — Large</td><td>3.75m &times; 7m</td><td>Larger teams &amp; meeting space</td></tr>
                                <tr><td>Accommodation — Single</td><td>3m &times; 9m</td><td>Single-room living</td></tr>
                                <tr><td>Accommodation — Double</td><td>3.75m &times; 9m</td><td>Double-room living</td></tr>
                                <tr><td>Toilet / Bathroom Cabin</td><td>2.4m &times; 4.8m</td><td>Sanitary blocks</td></tr>
                                <tr><td>Container Office</td><td>20ft / 40ft</td><td>Converted container workspace</td></tr>
                                <tr><td>Security / Guard Cabin</td><td>2m &times; 3m</td><td>Gatehouses &amp; guard posts</td></tr>
                                <tr><td>Labour Accommodation Block</td><td>10 rooms</td><td>Workforce camps</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p class="small text-muted mt-3 mb-0">Custom sizes available — every cabin is built to order. Indicative prices are on our <a href="/portable-cabin-price-in-qatar">portable cabin price guide</a>.</p>
                </div>
                <div class="col-lg-6" data-aos="fade-left">
                    <span class="section-label">Also Custom</span>
                    <h2 class="section-title mb-4">Portable Houses</h2>
                    <p class="text-muted">We also build portable houses — fully fitted, customizable living units with bedrooms, kitchens and bathrooms, delivered turnkey and ready to occupy. Share your drawings or requirements and we will quote for your exact size and specification.</p>
                    <p class="text-muted">Customization affects the final price: partitions, windows, doors, electrical fittings, air conditioning, branding and special layouts all add to the cost. Tell us what you need and we will price the exact specification — use the <a href="/#price-calculator">Porta Cabin Price Calculator</a> for an instant estimate, or <a href="/contact">request a quote</a>.</p>
                    <p class="text-muted">Delivery is turnkey: fully assembled or flat-pack units delivered direct to your site, with on-site installation by our specialised crew across Qatar.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="text-center mb-5" data-aos="fade-up">
                <span class="section-label">Good To Know</span>
                <h2 class="section-title">Frequently Asked Questions</h2>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-9">
                    <details class="faq-item" data-aos="fade-up">
                        <summary>Can I customize the design of my modular or portable unit?</summary>
                        <div class="faq-answer">Absolutely. We offer fully customizable layouts, finishes, features, and dimensions. Whether you need extra insulation, air conditioning, partitions, plumbing, or electrical work, our team can tailor your structure to meet your needs.</div>
                    </details>
                    <details class="faq-item" data-aos="fade-up">
                        <summary>What sizes do you fabricate?</summary>
                        <div class="faq-answer">We fabricate standard sizes from 2m &times; 3m guard cabins up to 3.75m &times; 9m accommodation units and 40ft container offices — see the sizes table above. Every cabin is built to order, so custom dimensions, layouts and fit-outs are available. See the full specifications on our <a href="/portable-cabin-fabrication">fabrication page</a>.</div>
                    </details>
                    <details class="faq-item" data-aos="fade-up">
                        <summary>Can cabins be stacked or joined together?</summary>
                        <div class="faq-answer">Yes. We build single and double-storey cabins, and modular units can be joined side-by-side into larger offices, workforce camps and command centres. See our <a href="/product/single-double-story-cabins">single &amp; double story cabins</a> for stacked configurations.</div>
                    </details>
                    <details class="faq-item" data-aos="fade-up">
                        <summary>Do you deliver and install across Qatar?</summary>
                        <div class="faq-answer">Yes. We deliver fully assembled or flat-pack units direct to your project site, and our specialised crew handles on-site installation — across Doha, Lusail, Al Wakrah, Al Rayyan, Mesaieed, Al Khor, Ras Laffan and beyond.</div>
                    </details>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-5" style="background:#111; color:#fff;">
        <div class="container text-center" data-aos="fade-up">
            <span class="section-label">Get Started</span>
            <h2 class="fw-bold text-uppercase mb-3" style="font-size:2.2rem;">Build Your Custom Cabin</h2>
            <p class="mb-4" style="color:#aaa;">Manufacturing portable cabins in Qatar since 2009. Send us your drawings or requirements — size, layout, finishes — and we will quote your exact specification.</p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a href="tel:+97450307568" class="btn-bc btn-bc-yellow"><i class="bi bi-telephone-fill me-2"></i> +974 50307568</a>
                <a href="mailto:info@bestchoiceqatar.net" class="btn-bc btn-bc-outline-white">info@bestchoiceqatar.net</a>
                <a href="/contact" class="btn-bc btn-bc-yellow">Request a Quote</a>
            </div>
            <p class="mt-4 mb-0 small" style="color:#888;">Also see: <a href="/portable-cabin-fabrication" style="color:#ffcc00;">Portable Cabin Fabrication</a> &middot; <a href="/portable-cabin-price-in-qatar" style="color:#ffcc00;">Portable Cabin Price Guide</a> &middot; <a href="/product/portable-office-cabins" style="color:#ffcc00;">Portable Office Cabins</a> &middot; <a href="/product/modular-cabins" style="color:#ffcc00;">Modular Cabins</a></p>
        </div>
    </section>


