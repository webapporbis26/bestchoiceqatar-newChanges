                    <div class="table-responsive">
                        <table class="table table-bordered bg-white mb-0">
                            <thead class="table-dark">
                                <tr><th scope="col">Cabin Type</th><th scope="col">Size</th><th scope="col">Indicative Price (QAR)</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Office Cabin &mdash; Standard</td><td>3M x 6M</td><td>8,000</td></tr>
                                <tr><td>Office Cabin &mdash; Large</td><td>3.75M x 7M</td><td>14,000</td></tr>
                                <tr><td>Toilet / Bathroom Cabin</td><td>2.4M x 4.8M</td><td>12,000</td></tr>
