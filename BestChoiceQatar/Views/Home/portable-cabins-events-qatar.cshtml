@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Portable Cabins for Events & Exhibitions in Qatar | BestChoice Contracting";
    ViewBag.description = "Portable cabins for events and exhibitions in Qatar \u2014 temporary offices, ticket cabins, guard posts, welfare units and VIP toilets for event organizers. Guard cabins ready in 5\u201310 working days. Since 2009.";
    ViewBag.keywords = "portable cabins events qatar, event cabins doha, ticket cabin qatar, exhibition cabins, temporary event offices";
}

<main id="main" class="product-detail-page">

