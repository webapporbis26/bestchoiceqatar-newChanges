    ViewBag.description = "Premium portable toilets and ablution blocks for construction sites and events in Qatar. Easy clean, durable, and high-hygiene modular units in Doha.";
    ViewBag.keywords = "portable toilets qatar, ablution block doha, mobile toilet qatar, sanitary units doha";
}

<main id="main" class="product-detail-page">

    <!-- Hero Section -->
    <section class="page-hero" style="background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/Uploads/Products/Fabrication-2.jpg') center/cover no-repeat; padding: 120px 0 80px;">
        <div class="container text-center" data-aos="fade-up">
            <h1 class="display-4 fw-bold text-white mb-3">Portable Toilets & Ablution</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center">
                    <li class="breadcrumb-item"><a href="/index" class="text-warning">Home</a></li>
                    <li class="breadcrumb-item"><a href="/portable-cabin-fabrication" class="text-warning">Fabrication</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">Portable Toilets</li>
                </ol>
            </nav>
        </div>
    </section>

    <!-- Content Section -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6 order-lg-2" data-aos="fade-left">
                    <span class="section-label">Hygiene & Comfort</span>
                    <h2 class="section-title">High-Standard Sanitary Solutions</h2>
                    <p class="lead text-muted mt-4">We provide high-hygiene portable toilet units and comprehensive ablution blocks designed for long-term site deployment across Qatar.</p>
                    <p class="text-muted">Our sanitary units feature easy-clean PVC or ceramic finishes, heavy-duty plumbing, and efficient ventilation to maintain a clean environment for your workforce.</p>
                    
                    <div class="row mt-4">
                        <div class="col-md-6 mb-3">
                            <ul class="list-unstyled">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Durable Plumbing</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Anti-Bacterial Panels</li>
                            </ul>
                        </div>
                        <div class="col-md-6 mb-3">
                            <ul class="list-unstyled">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Exhaust Ventilation</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Water Tank Options</li>
                            </ul>
                        </div>
                    </div>

                    <a href="/contact" class="btn-bc btn-bc-yellow mt-4">Inquire Now <i class="bi bi-arrow-right ms-2"></i></a>
                </div>
                <div class="col-lg-6 order-lg-1" data-aos="fade-right">
                    <div class="position-relative text-center">
                        <img src="/Uploads/WhatsApp Image 2026-04-22 at 3.41.43 PM.jpeg" class="img-fluid shadow-lg" alt="Portable Toilet Unit" style="border-radius: 20px;">
                        <div class="bg-primary-yellow position-absolute p-4 d-none d-md-block" style="top: -30px; left: -30px; border-radius: 15px; max-width: 250px;">
                            <h5 class="fw-bold mb-0 text-dark">Hygienic & Durable</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Types & Specifications Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-6" data-aos="fade-right">
                    <span class="section-label">Types &amp; Configurations</span>
                    <h2 class="section-title mb-4">From Single WC to Full Ablution Complexes</h2>
                    <p class="text-muted">Our sanitary units range from single person mobile toilets to massive multi-bay ablution blocks featuring showers, washbasins, and laundry facilities.</p>
                    <ul class="list-unstyled mt-4">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Individual WC</strong> — single-person mobile toilets</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Shower Blocks</strong> — showers, washbasins and laundry facilities</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Full Ablution Complexes</strong> — multi-bay blocks for large workforces</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>VIP Toilets</strong> — premium units for events, with hand-washing stations, urinals or showers</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Male / Female separate entrances</strong> available on every block</li>
                    </ul>
                    <p class="text-muted">Every unit is pressure-tested before delivery to ensure leak-free operation and seamless integration with site sewage tanks or mains connections.</p>
                </div>
                <div class="col-lg-6" data-aos="fade-left">
                    <span class="section-label">Built To Last</span>
                    <h2 class="section-title mb-4">Specifications</h2>
                    <div class="table-responsive">
                        <table class="table table-bordered bg-white mb-0">
                            <tbody>
                                <tr><th scope="row" style="width:38%;">Types</th><td>Individual WC / Shower Blocks / Full Ablution Complexes</td></tr>
                                <tr><th scope="row">Flooring</th><td>Anti-slip checkered aluminium / PVC flooring</td></tr>
                                <tr><th scope="row">Plumbing</th><td>C-PVC / PPR high-grade plumbing for hot &amp; cold water</td></tr>
                                <tr><th scope="row">Fittings</th><td>Premium ceramic / stainless steel options</td></tr>
                                <tr><th scope="row">Ventilation</th><td>Forced extraction ventilation systems (exhaust fans)</td></tr>
                                <tr><th scope="row">Tanking</th><td>Optional integrated fresh / waste water tanks; sewage-tank or mains integration</td></tr>
                                <tr><th scope="row">Insulation</th><td>Moisture-sealed EPS panels</td></tr>
                                <tr><th scope="row">Indicative Price</th><td>Toilet / Bathroom Cabin 2.4M x 4.8M — from QAR 12,000</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p class="small text-muted mt-3">Prices are indicative only. See the full <a href="/portable-cabin-price-in-qatar">portable cabin price guide</a> or view the <a href="/product/toilet-sanitary-cabins">toilet &amp; sanitary cabins</a> product page.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-5" style="background:#111; color:#fff;">
        <div class="container text-center" data-aos="fade-up">
            <h2 class="fw-bold text-uppercase mb-3" style="font-size:2rem;">Need Sanitary Units for Your Site or Event?</h2>
            <p class="mb-4" style="color:#aaa;">Manufacturing portable cabins in Qatar since 2009. Call us or request a quote for toilet cabins, shower blocks or full ablution complexes.</p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a href="tel:+97450307568" class="btn-bc btn-bc-yellow"><i class="bi bi-telephone-fill me-2"></i> +974 50307568</a>
                <a href="/contact" class="btn-bc btn-bc-yellow">Request a Quote</a>
            </div>
        </div>
    </section>

</main>

