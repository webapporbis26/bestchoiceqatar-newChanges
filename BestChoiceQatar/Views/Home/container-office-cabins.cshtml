@{
    ViewBag.Title = "Container Offices Qatar | Modern Shipping Container Conversions";
    ViewBag.description = "Bespoke container offices and shipping container conversions in Qatar. High-durability, architecturally designed, and ready for rapid deployment in Doha.";
    ViewBag.keywords = "container office qatar, shipping container conversion doha, modular container office, bespoke container qatar";
}

<main id="main" class="product-detail-page">

    <!-- Hero Section -->
    <section class="page-hero" style="background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/Uploads/Products/cabin-2.jpg') center/cover no-repeat; padding: 120px 0 80px;">
        <div class="container text-center" data-aos="fade-up">
            <h1 class="display-4 fw-bold text-white mb-3">Container Offices</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center">
                    <li class="breadcrumb-item"><a href="/index" class="text-warning">Home</a></li>
                    <li class="breadcrumb-item"><a href="/portable-cabin-fabrication" class="text-warning">Fabrication</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">Container Offices</li>
                </ol>
            </nav>
        </div>
    </section>

    <!-- Content Section -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6" data-aos="fade-right">
                    <span class="section-label">Architectural Innovation</span>
                    <h2 class="section-title">Modern Shipping Container Conversions</h2>
                    <p class="lead text-muted mt-4">We transform standard 20ft and 40ft shipping containers into architecturally stunning and highly functional office spaces.</p>
                    <p class="text-muted">Featuring modern industrial aesthetics, high-performance insulation, and premium interior finishes, our container offices are ideal for luxury site offices and marketing suites.</p>
                    
                    <div class="row mt-4">
                        <div class="col-md-6 mb-3">
                            <ul class="list-unstyled">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> 20ft & 40ft Options</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Industrial Chic Design</li>
                            </ul>
                        </div>
                        <div class="col-md-6 mb-3">
                            <ul class="list-unstyled">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Marine-Grade Steel</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Premium Glazing</li>
                            </ul>
                        </div>
                    </div>

                    <a href="/contact" class="btn-bc btn-bc-yellow mt-4">Request Bespoke Design <i class="bi bi-arrow-right ms-2"></i></a>
                </div>
                <div class="col-lg-6" data-aos="fade-left">
                    <div class="position-relative text-center">
                        <img src="/Uploads/WhatsApp Image 2026-04-22 at 3.41.45 PM.jpeg" class="img-fluid shadow-lg" alt="Container Office Conversion" style="border-radius: 20px;">
                        <div class="bg-primary-yellow position-absolute p-4 d-none d-md-block" style="bottom: -30px; right: -30px; border-radius: 15px; max-width: 250px;">
                            <h5 class="fw-bold mb-0 text-dark">Modern Industrial Style</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Specifications & Sizes Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-6" data-aos="fade-right">
                    <span class="section-label">Built To Last</span>
                    <h2 class="section-title mb-4">Specifications</h2>
                    <div class="table-responsive">
                        <table class="table table-bordered bg-white mb-0">
                            <tbody>
                                <tr><th scope="row" style="width:38%;">Sizes</th><td>20ft (6.06M) / 40ft (12.19M) / High-Cube</td></tr>
                                <tr><th scope="row">Structure</th><td>Authentic ISO Corten steel</td></tr>
                                <tr><th scope="row">Wall Lining</th><td>Gypsum / Marine Ply / Steel Sheet Options</td></tr>
                                <tr><th scope="row">Floor Type</th><td>Original 28mm Marine Plywood + Vinyl Overlay</td></tr>
                                <tr><th scope="row">Exterior</th><td>Marine-grade Epoxy Primer + PU Topcoat</td></tr>
                                <tr><th scope="row">Stacking</th><td>Stackable up to three levels high</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-lg-6" data-aos="fade-left">
                    <span class="section-label">Sizes &amp; Pricing</span>
                    <h2 class="section-title mb-4">20ft or 40ft &mdash; Your Choice</h2>
                    <p class="text-muted">Container offices are converted from standard ISO shipping containers in our Qatar facility, with bespoke layouts available on request.</p>
                    <div class="table-responsive">
                        <table class="table table-bordered bg-white mb-0">
                            <tbody>
                                <tr><th scope="row" style="width:38%;">20ft Container Office &mdash; 6.06M</th><td>From QAR 35,000</td></tr>
                                <tr><th scope="row">40ft Container Office &mdash; 12.19M</th><td>From QAR 55,000</td></tr>
                                <tr><th scope="row">High-Cube options</th><td>Available &mdash; ask for a quote</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p class="small text-muted mt-3">Prices are indicative only. See the full <a href="/portable-cabin-price-in-qatar">portable cabin price guide</a> or our <a href="/shipping-container-modifications-qatar">container modifications page</a>.</p>
                </div>
            </div>
            <div class="row mt-5">
                <div class="col-12" data-aos="fade-up">
                    <span class="section-label">Industries Served</span>
                    <h2 class="section-title mb-4">Where Container Offices Work</h2>
                    <ul class="list-unstyled mt-4">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Construction &amp; Infrastructure</strong> &mdash; high-security site offices and workshops</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Oil, Gas &amp; Energy</strong> &mdash; remote site offices and equipment rooms</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Commercial &amp; Retail</strong> &mdash; marketing suites and pop-up offices</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Events &amp; Exhibitions</strong> &mdash; ticket offices, control rooms and crew facilities</li>
                    </ul>
                    <p class="text-muted">Every unit is delivered turnkey &mdash; fully fitted and ready for immediate operation &mdash; with on-site installation anywhere in Qatar. Learn how they are built on our <a href="/portable-cabin-fabrication">fabrication page</a>.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto" data-aos="fade-up">
                    <span class="section-label">FAQ</span>
                    <h2 class="section-title mb-4">Container Office Questions, Answered</h2>
                    <details class="faq-item">
                        <summary>What is the difference between a 20ft and a 40ft container office?</summary>
                        <div class="faq-answer">The 20ft unit (6.06M) starts from QAR 35,000 and suits compact site offices, stores and workshops. The 40ft unit (12.19M) starts from QAR 55,000 and gives nearly double the floor area for larger offices, IT or server rooms and storage. High-cube options are also available.</div>
                    </details>
                    <details class="faq-item">
                        <summary>Are container offices insulated for Qatar heat?</summary>
                        <div class="faq-answer">Yes. Conversions use EPS or Rockwool insulation with gypsum, marine ply or steel-sheet internal lining, plus T3 tropical-rated AC provisions for 50&deg;C+ heat.</div>
                    </details>
                    <details class="faq-item">
                        <summary>Can container offices be stacked?</summary>
                        <div class="faq-answer">Yes. The authentic ISO Corten steel structure is naturally stackable up to three levels high without additional external framework.</div>
                    </details>
                    <details class="faq-item">
                        <summary>What are container offices used for?</summary>
                        <div class="faq-answer">Site offices, IT and server rooms, remote site workshops, marketing suites and luxury site offices &mdash; anywhere security and structural strength matter.</div>
                    </details>
                    <details class="faq-item">
                        <summary>How are container offices delivered?</summary>
                        <div class="faq-answer">Each unit is a turnkey solution delivered fully fitted and ready for immediate operation, relocatable by crane or container handler.</div>
                    </details>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-5" style="background:#111; color:#fff;">
        <div class="container text-center" data-aos="fade-up">
            <h2 class="fw-bold text-uppercase mb-3" style="font-size:2rem;">Need a Container Office for Your Site?</h2>
            <p class="mb-4" style="color:#aaa;">Manufacturing portable cabins in Qatar since 2009. Call us or request a quote for 20ft or 40ft container offices.</p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a href="tel:+97450307568" class="btn-bc btn-bc-yellow"><i class="bi bi-telephone-fill me-2"></i> +974 50307568</a>
                <a href="/contact" class="btn-bc btn-bc-yellow">Request a Quote</a>
            </div>
        </div>
    </section>

    <!-- Product + FAQ JSON-LD -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Product",
      "name": "Container Offices Qatar | BestChoice Contracting Qatar",
      "description": "Bespoke container offices and shipping container conversions in Qatar. High-durability, architecturally designed, and ready for rapid deployment in Doha.",
      "brand": { "@@type": "Brand", "name": "BestChoice Contracting Qatar" },
      "category": "Portable Cabins",
      "offers": { "@@type": "Offer", "priceCurrency": "QAR", "price": "35000", "availability": "https://schema.org/PreOrder", "itemCondition": "https://schema.org/NewCondition" }
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "FAQPage",
      "mainEntity": [
        { "@@type": "Question", "name": "What is the difference between a 20ft and a 40ft container office?", "acceptedAnswer": { "@@type": "Answer", "text": "The 20ft unit (6.06M) starts from QAR 35,000 and suits compact site offices, stores and workshops. The 40ft unit (12.19M) starts from QAR 55,000 and gives nearly double the floor area for larger offices, IT or server rooms and storage. High-cube options are also available." } },
        { "@@type": "Question", "name": "Are container offices insulated for Qatar heat?", "acceptedAnswer": { "@@type": "Answer", "text": "Yes. Conversions use EPS or Rockwool insulation with gypsum, marine ply or steel-sheet internal lining, plus T3 tropical-rated AC provisions for 50\u00b0C+ heat." } },
        { "@@type": "Question", "name": "Can container offices be stacked?", "acceptedAnswer": { "@@type": "Answer", "text": "Yes. The authentic ISO Corten steel structure is naturally stackable up to three levels high without additional external framework." } },
        { "@@type": "Question", "name": "What are container offices used for?", "acceptedAnswer": { "@@type": "Answer", "text": "Site offices, IT and server rooms, remote site workshops, marketing suites and luxury site offices \u2014 anywhere security and structural strength matter." } },
        { "@@type": "Question", "name": "How are container offices delivered?", "acceptedAnswer": { "@@type": "Answer", "text": "Each unit is a turnkey solution delivered fully fitted and ready for immediate operation, relocatable by crane or container handler." } }
      ]
    }
    </script>

</main>

<style>
    .section-label { font-size: 0.8rem; font-weight: 700; color: #ffcc00; text-transform: uppercase; letter-spacing: 2px; display: block; margin-bottom: 10px; }
    .section-title { font-size: 2.5rem; font-weight: 800; color: #111; line-height: 1.2; }
    .btn-bc { display: inline-flex; align-items: center; padding: 15px 35px; font-weight: 700; border-radius: 5px; transition: all 0.3s; text-decoration: none; text-transform: uppercase; font-size: 0.9rem; }
    .btn-bc-yellow { background: #ffcc00; color: #111; }
    .btn-bc-yellow:hover { background: #111; color: #ffcc00; }
    .faq-item { border: 1px solid #eee; margin-bottom: 12px; background: #fff; }
    .faq-item summary { padding: 20px 24px; font-weight: 700; cursor: pointer; list-style: none; font-size: 1.05rem; }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary:after { content: "+"; float: right; color: #ffcc00; font-size: 1.4rem; line-height: 1; }
    .faq-item[open ] summary:after { content: "\2013"; }
    .faq-item .faq-answer { padding: 0 24px 20px; color: #555; line-height: 1.8; }
</style>
