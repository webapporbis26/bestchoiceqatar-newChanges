@{
    ViewBag.Title = "Portable Site Cabins Qatar | Rugged Workforce Solutions";
    ViewBag.description = "Durable portable site cabins for workforce accommodation and operational support in Qatar. Engineered for harsh industrial environments and rapid deployment.";
    ViewBag.keywords = "portable site cabins qatar, workforce accommodation doha, site units qatar, industrial cabins";
}

<main id="main" class="product-detail-page">

    <!-- Hero Section -->
    <section class="page-hero" style="background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/Uploads/Products/cabin-2.jpg') center/cover no-repeat; padding: 120px 0 80px;">
        <div class="container text-center" data-aos="fade-up">
            <h1 class="display-4 fw-bold text-white mb-3">Portable Site Cabins</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center">
                    <li class="breadcrumb-item"><a href="/index" class="text-warning">Home</a></li>
                    <li class="breadcrumb-item"><a href="/portable-cabin-fabrication" class="text-warning">Fabrication</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">Site Cabins</li>
                </ol>
            </nav>
        </div>
    </section>

    <!-- Content Section -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6 order-lg-2" data-aos="fade-left">
                    <span class="section-label">Industrial Grade</span>
                    <h2 class="section-title">Rugged Site Units for Qatar Projects</h2>
                    <p class="lead text-muted mt-4">Our portable site cabins are designed to withstand the toughest industrial conditions, providing reliable support for your workforce.</p>
                    <p class="text-muted">Built for repeated relocation and extreme weather resistance, these units are the preferred choice for major infrastructure projects in Mesaieed and Ras Laffan.</p>
                    
                    <div class="row mt-4">
                        <div class="col-md-6 mb-3">
                            <ul class="list-unstyled">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Heavy Duty Chassis</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Weatherproof Seals</li>
                            </ul>
                        </div>
                        <div class="col-md-6 mb-3">
                            <ul class="list-unstyled">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Easy Clean Interiors</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Fast Relocation</li>
                            </ul>
                        </div>
                    </div>

                    <a href="/contact" class="btn-bc btn-bc-yellow mt-4">Get Site Pricing <i class="bi bi-arrow-right ms-2"></i></a>
                </div>
                <div class="col-lg-6 order-lg-1" data-aos="fade-right">
                    <div class="position-relative">
                        <img src="/Uploads/WhatsApp Image 2026-04-22 at 3.41.44 PM (1).jpeg" class="img-fluid shadow-lg" alt="Portable Site Cabin" style="border-radius: 20px;">
                        <div class="bg-primary-yellow position-absolute p-4 d-none d-md-block" style="top: -30px; left: -30px; border-radius: 15px; max-width: 250px;">
                            <h5 class="fw-bold mb-0 text-dark">Built for Industrial Use</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Specifications & Sizes Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-6" data-aos="fade-right">
                    <span class="section-label">Built To Last</span>
                    <h2 class="section-title mb-4">Specifications</h2>
                    <div class="table-responsive">
                        <table class="table table-bordered bg-white mb-0">
                            <tbody>
                                <tr><th scope="row" style="width:38%;">Frame</th><td>Structural Steel C-Channels &amp; Square Tubes</td></tr>
                                <tr><th scope="row">Insulation</th><td>High-density EPS / Rockwool Options</td></tr>
                                <tr><th scope="row">Lifting</th><td>4-Point ISO standard corner lifting hooks</td></tr>
                                <tr><th scope="row">Roof</th><td>Corrugated Steel with Integrated Guttering</td></tr>
                                <tr><th scope="row">Doors</th><td>Insulated Steel Doors with Heavy-duty Hardware</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-lg-6" data-aos="fade-left">
                    <span class="section-label">Sizes &amp; Pricing</span>
                    <h2 class="section-title mb-4">Workforce Accommodation Sizes</h2>
                    <p class="text-muted">Site cabins are commonly supplied as workforce accommodation units, with custom footprints built to order.</p>
                    <div class="table-responsive">
                        <table class="table table-bordered bg-white mb-0">
                            <tbody>
                                <tr><th scope="row" style="width:38%;">Accommodation Single &mdash; 3M x 9M</th><td>From QAR 20,000</td></tr>
                                <tr><th scope="row">Accommodation Double &mdash; 3.75M x 9M</th><td>From QAR 28,000</td></tr>
                                <tr><th scope="row">Custom footprints</th><td>Built to order &mdash; share your requirements for a quote</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p class="small text-muted mt-3">Prices are indicative only. See the full <a href="/portable-cabin-price-in-qatar">portable cabin price guide</a>.</p>
                </div>
            </div>
            <div class="row mt-5">
                <div class="col-12" data-aos="fade-up">
                    <span class="section-label">Industries Served</span>
                    <h2 class="section-title mb-4">Where Site Cabins Work</h2>
                    <ul class="list-unstyled mt-4">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Construction &amp; Infrastructure</strong> &mdash; workforce accommodation and site compounds</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Oil, Gas &amp; Energy</strong> &mdash; the preferred choice for oil &amp; gas sites in Ras Laffan and Mesaieed</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Events &amp; Exhibitions</strong> &mdash; back-of-house and crew facilities</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> <strong>Commercial &amp; Retail</strong> &mdash; storage and operational control centres</li>
                    </ul>
                    <p class="text-muted">Every cabin is delivered turnkey &mdash; flat-pack or fully assembled &mdash; with on-site installation anywhere in Qatar. Learn how they are built on our <a href="/portable-cabin-fabrication">fabrication page</a>.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto" data-aos="fade-up">
                    <span class="section-label">FAQ</span>
                    <h2 class="section-title mb-4">Site Cabin Questions, Answered</h2>
                    <details class="faq-item">
                        <summary>What are portable site cabins used for?</summary>
                        <div class="faq-answer">Workforce accommodation, site storage and operational control centres on construction and industrial project sites across Qatar.</div>
                    </details>
                    <details class="faq-item">
                        <summary>Are site cabins built for harsh industrial sites?</summary>
                        <div class="faq-answer">Yes. They are built on heavy-duty structural steel frames with weather-resistant seals, EPS or Rockwool insulation and 4-point ISO standard corner lifting hooks for crane transport.</div>
                    </details>
                    <details class="faq-item">
                        <summary>Can site cabins be joined into larger compounds?</summary>
                        <div class="faq-answer">Yes. The units are modular and can be interconnected to create large-scale site compounds, offices, welfare blocks and accommodation in one integrated setup.</div>
                    </details>
                    <details class="faq-item">
                        <summary>Which industries use your site cabins?</summary>
                        <div class="faq-answer">Construction and infrastructure, oil and gas &mdash; our site cabins are the preferred choice for oil and gas sites in Ras Laffan and Mesaieed &mdash; as well as events and exhibitions.</div>
                    </details>
                    <details class="faq-item">
                        <summary>How are site cabins delivered?</summary>
                        <div class="faq-answer">Delivered turnkey with on-site installation by our own crew, fully assembled or flat-pack, anywhere in Qatar.</div>
                    </details>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-5" style="background:#111; color:#fff;">
        <div class="container text-center" data-aos="fade-up">
            <h2 class="fw-bold text-uppercase mb-3" style="font-size:2rem;">Need Site Cabins for Your Project?</h2>
            <p class="mb-4" style="color:#aaa;">Manufacturing portable cabins in Qatar since 2009. Call us or request a quote for site cabins and workforce accommodation.</p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a href="tel:+97450307568" class="btn-bc btn-bc-yellow"><i class="bi bi-telephone-fill me-2"></i> +974 50307568</a>
                <a href="/contact" class="btn-bc btn-bc-yellow">Request a Quote</a>
            </div>
        </div>
    </section>

    <!-- Product + FAQ JSON-LD -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Product",
      "name": "Portable Site Cabins Qatar | BestChoice Contracting Qatar",
      "description": "Durable portable site cabins for workforce accommodation and operational support in Qatar. Engineered for harsh industrial environments and rapid deployment.",
      "brand": { "@@type": "Brand", "name": "BestChoice Contracting Qatar" },
      "category": "Portable Cabins"
    }
    </script>
    <script type="application/ld+json">
    {
