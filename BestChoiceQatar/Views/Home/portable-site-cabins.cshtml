      "@@type": "FAQPage",
      "mainEntity": [
        { "@@type": "Question", "name": "What are portable site cabins used for?", "acceptedAnswer": { "@@type": "Answer", "text": "Workforce accommodation, site storage and operational control centres on construction and industrial project sites across Qatar." } },
        { "@@type": "Question", "name": "Are site cabins built for harsh industrial sites?", "acceptedAnswer": { "@@type": "Answer", "text": "Yes. They are built on heavy-duty structural steel frames with weather-resistant seals, EPS or Rockwool insulation and 4-point ISO standard corner lifting hooks for crane transport." } },
